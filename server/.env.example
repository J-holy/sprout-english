# ===== 새싹영어 서버 설정 =====
# 이 파일을 .env 로 복사해서 값을 채우세요:  cp .env.example .env
# 자세한 설명은 deploy/DEPLOY.md 를 보세요.

# --- 기본 ---
NODE_ENV=production
# 실제 접속 주소 (구입한 도메인). 끝에 / 없이. SNS 로그인·결제 콜백 주소가 이 값으로 만들어져요.
PUBLIC_URL=https://example.com
# 서버는 Caddy(HTTPS) 뒤에서 이 주소로만 열려요
HOST=127.0.0.1
PORT=8080
# 32자 이상 무작위 값:  openssl rand -hex 32
SESSION_SECRET=
SESSION_DAYS=60
# 관리자 이메일 (쉼표로 여러 개). 이 이메일로 로그인하면 관리자 권한이 생겨요.
ADMIN_EMAILS=admin@example.com
DATA_DIR=./data

# --- 이메일 인증코드 발송 (SMTP) ---
# 예) 네이버 메일: smtp.naver.com / 465 / 네이버 아이디@naver.com / 비밀번호(2단계 인증 시 앱 비밀번호)
# 예) Gmail: smtp.gmail.com / 465 / 주소@gmail.com / 앱 비밀번호 16자리
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=새싹영어 <no-reply@example.com>
# SMTP 없이 테스트할 때만 true (인증코드를 화면에 보여줌). 운영에서는 반드시 false.
DEV_SHOW_CODE=false
CODE_TTL_SEC=180
CODE_MAX_TRIES=5
CODE_RESEND_SEC=30

# --- SNS 로그인 (비워두면 그 버튼은 숨겨져요) ---
# 각 서비스 개발자 콘솔에 Redirect URI 를 다음처럼 등록하세요:  {PUBLIC_URL}/api/auth/<kakao|naver|google|apple>/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/opt/sprout-english/server/secrets/AuthKey.p8

# --- 결제: 토스페이먼츠 자동결제(빌링) ---
# 테스트 키(test_ck_..., test_sk_...)로 먼저 확인하고, 계약 후 라이브 키로 바꾸세요.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 토스 키가 없을 때 즉시 완료되는 데모 결제를 허용할지 (운영에서는 false)
ALLOW_DEMO_PAYMENT=false

# --- AI 음성 (선택, 자연스러운 낭독) ---
# 둘 중 하나만 넣으면 돼요. 문장마다 한 번만 만들어 data/tts 에 저장하고 다시 쓰니 비용이 거의 들지 않아요.
# OpenAI: platform.openai.com › API keys.  목소리: nova(밝은 여성), shimmer, coral, alloy, echo, sage ...
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
# Google Cloud: Text-to-Speech API 사용 설정 후 API 키 발급 (월 100만 자 무료). 목소리 예: en-US-Neural2-F, en-US-Neural2-C
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-F
# 둘 다 넣었을 때 고르기 (openai 또는 google)
TTS_PROVIDER=

# --- 백업 ---
BACKUP_KEEP=14
